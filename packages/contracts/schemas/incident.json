{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FullShelfIncident",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "incident_id": { "type": "string", "minLength": 1 },
    "parent_coordinator_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "incident_type": {
      "type": "string",
      "enum": ["TRUCK_BREAKDOWN", "FOOD_SAFETY_RECALL", "DEADLINE_HOLD"]
    },
    "status": {
      "type": "string",
      "enum": [
        "DETECTED", "SCOPING", "CONTAINMENT_IN_PROGRESS",
        "PARTIALLY_CONTAINED", "CONTAINED", "CLOSED",
        "ACTIVE", "RESOLVED", "ACKNOWLEDGMENT_HOLD_ACTIVE"
      ]
    },
    "terminal_state": {
      "type": "string",
      "enum": ["NONE", "PARTIALLY_CONTAINED", "CONTAINED", "CLOSED"]
    },
    "affected_lot_id": { "type": ["string", "null"] },
    "details": {
      "type": "object",
      "properties": {
        "model_armor_correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": [
    "incident_id", "parent_coordinator_id", "tenant_id", "incident_type",
    "status", "terminal_state", "created_at"
  ]
}
