{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecurringDailyRequest",
  "description": "Date-free managed Scheduler request. The verified Pub/Sub publishTime supplies operating_day.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "tenant_id", "operating_plan"],
  "properties": {
    "event_type": { "const": "PLAN_DAY_REQUESTED" },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,54}$"
    },
    "operating_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_name", "plan_id", "revision", "status", "orders", "lots",
        "vehicles", "custody_nodes", "custody_edges"
      ],
      "properties": {
        "tenant_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "plan_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "revision": { "const": "rev07" },
        "status": { "const": "ACTIVE" },
        "orders": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "lots": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "vehicles": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "custody_nodes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "custody_edges": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    }
  }
}
