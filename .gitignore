# Local demo scratch. A rule cannot re-include a file inside an excluded
# DIRECTORY, so the contents are excluded and the deployment record — the
# operational document for the hosted judge replay, not scratch — is
# re-included by name.
docs/demo/*
!docs/demo/PUBLIC_REPLAY_DEPLOYMENT.md
